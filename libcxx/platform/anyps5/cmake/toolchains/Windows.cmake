set(ANYLIBCXX_TARGET windows)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT ANYLIBCXX_SYSROOT OR NOT IS_DIRECTORY "${ANYLIBCXX_SYSROOT}/include")
    message(FATAL_ERROR "ANYLIBCXX_SYSROOT must contain the MinGW headers")
endif()
set(CMAKE_SYSROOT "${ANYLIBCXX_SYSROOT}")
set(ANYLIBCXX_COMPILER clang CACHE STRING "Compiler family: clang or gcc")
set_property(CACHE ANYLIBCXX_COMPILER PROPERTY STRINGS clang gcc)
if(ANYLIBCXX_COMPILER STREQUAL "clang")
    set(CMAKE_C_COMPILER clang)
    set(CMAKE_CXX_COMPILER clang++)
    set(CMAKE_ASM_COMPILER clang)
    set(CMAKE_C_COMPILER_TARGET x86_64-w64-windows-gnu)
    set(CMAKE_CXX_COMPILER_TARGET x86_64-w64-windows-gnu)
    set(CMAKE_ASM_COMPILER_TARGET x86_64-w64-windows-gnu)
    set(CMAKE_CXX_FLAGS_INIT "-fdwarf-exceptions")
elseif(ANYLIBCXX_COMPILER STREQUAL "gcc")
    set(CMAKE_C_COMPILER gcc)
    set(CMAKE_CXX_COMPILER g++)
    set(CMAKE_ASM_COMPILER gcc)
    set(CMAKE_CXX_FLAGS_INIT "")
else()
    message(FATAL_ERROR "ANYLIBCXX_COMPILER must be clang or gcc")
endif()
set(CMAKE_C_FLAGS_INIT "-fno-stack-protector -fno-stack-check -mno-stack-arg-probe")
string(APPEND CMAKE_CXX_FLAGS_INIT " -fno-stack-protector -fno-stack-check -mno-stack-arg-probe")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ANYLIBCXX_SYSROOT ANYLIBCXX_COMPILER)
