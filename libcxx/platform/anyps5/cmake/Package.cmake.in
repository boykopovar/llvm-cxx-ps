set(packageName "llvm-cxx-ps-@ANYLIBCXX_PACKAGE_PLATFORM@-x86_64")
set(components cxx-headers)
set(entries include LICENSE.TXT)
if(HEADERS_ONLY)
    string(APPEND packageName "-headers")
else()
    list(APPEND components anylibcxx)
    list(APPEND entries lib)
endif()
set(destination "@CMAKE_CURRENT_BINARY_DIR@/packages/${packageName}")
foreach(component IN LISTS components)
    execute_process(COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@" --prefix "${destination}" --component "${component}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
execute_process(COMMAND "@CMAKE_COMMAND@" -E tar cf "../${packageName}.zip" --format=zip ${entries} WORKING_DIRECTORY "${destination}" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${destination}.zip" digest)
file(WRITE "${destination}.zip.sha256" "${digest}  ${packageName}.zip\n")
