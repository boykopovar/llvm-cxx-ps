set(packageName "llvm-cxx-ps-@ANYLIBCXX_PACKAGE_VERSION@-@ANYLIBCXX_PACKAGE_PLATFORM@-x86_64")
set(components cxx-headers)
set(entries include LICENSE.TXT)
if(HEADERS_ONLY)
    string(APPEND packageName "-headers")
else()
    list(APPEND components anylibcxx)
    list(APPEND entries lib)
endif()
set(destination "@CMAKE_CURRENT_BINARY_DIR@/packages/${packageName}")
file(REMOVE_RECURSE "${destination}")
foreach(component IN LISTS components)
    execute_process(COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@" --prefix "${destination}" --component "${component}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
if(HEADERS_ONLY OR "@ANYLIBCXX_PACKAGE_PLATFORM@" STREQUAL "windows")
    set(extension zip)
    set(options cf)
    set(format --format=zip)
else()
    set(extension tar.gz)
    set(options czf)
    set(format --format=gnutar)
endif()
set(archive "${packageName}.${extension}")
execute_process(COMMAND "@CMAKE_COMMAND@" -E tar ${options} "../${archive}" ${format} ${entries} WORKING_DIRECTORY "${destination}" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${destination}.${extension}" digest)
file(WRITE "${destination}.${extension}.sha256" "${digest}  ${archive}\n")
