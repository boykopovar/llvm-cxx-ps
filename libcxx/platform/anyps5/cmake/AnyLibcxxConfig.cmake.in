if(TARGET AnyLibcxx::Runtime)
    get_target_property(ANYLIBCXX_WINDOWS_IMPORTS AnyLibcxx::Runtime ANYLIBCXX_WINDOWS_IMPORTS)
    return()
endif()

if(CMAKE_CXX_COMPILER_TARGET)
    if(NOT CMAKE_CXX_COMPILER_TARGET MATCHES "^x86_64-")
        message(FATAL_ERROR "AnyLibcxx requires an x86_64 compiler target")
    endif()
else()
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" anyLibcxxArchitecture)
    if(NOT anyLibcxxArchitecture MATCHES "^(amd64|x86_64)$" AND NOT CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "x64")
        message(FATAL_ERROR "AnyLibcxx requires x86_64")
    endif()
endif()
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "AnyLibcxx requires 64-bit Clang")
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "@CMAKE_SYSTEM_NAME@")
    message(FATAL_ERROR "This AnyLibcxx build targets @CMAKE_SYSTEM_NAME@")
endif()

set(anyLibcxxRuntime "${CMAKE_CURRENT_LIST_DIR}/3rdparty/llvm-project/runtimes")
foreach(required "${anyLibcxxRuntime}/include/c++/v1/__config_site" "${anyLibcxxRuntime}/lib/libc++.a")
    if(NOT EXISTS "${required}")
        message(FATAL_ERROR "Incomplete AnyLibcxx build: ${required}")
    endif()
endforeach()

add_library(AnyLibcxx::Runtime STATIC IMPORTED GLOBAL)
set_target_properties(AnyLibcxx::Runtime PROPERTIES IMPORTED_LOCATION "${anyLibcxxRuntime}/lib/libc++.a")
target_compile_features(AnyLibcxx::Runtime INTERFACE cxx_std_20)
target_include_directories(AnyLibcxx::Runtime SYSTEM INTERFACE "${anyLibcxxRuntime}/include/c++/v1")
target_compile_options(AnyLibcxx::Runtime INTERFACE -nostdinc++ -fshort-wchar)
target_compile_definitions(AnyLibcxx::Runtime INTERFACE __NO_CTYPE __errno_location=_Geterrno)
target_link_options(AnyLibcxx::Runtime INTERFACE -nostdlib++)

if(WIN32)
    target_include_directories(AnyLibcxx::Runtime SYSTEM INTERFACE "${anyLibcxxRuntime}/include/anyps5")
    target_compile_options(AnyLibcxx::Runtime INTERFACE -fdwarf-exceptions -fno-stack-protector -fno-stack-check -mno-stack-arg-probe)
    target_compile_definitions(AnyLibcxx::Runtime INTERFACE _CRTIMP= __USE_MINGW_ANSI_STDIO=0 __MSVCRT_VERSION__=0x700 _CRT_SECURE_CPP_OVERLOAD_SECURE_NAMES=0)
    include("${CMAKE_CURRENT_LIST_DIR}/WindowsImports.cmake")
    set_property(TARGET AnyLibcxx::Runtime PROPERTY ANYLIBCXX_WINDOWS_IMPORTS "${ANYLIBCXX_WINDOWS_IMPORTS}")
endif()
